# Copier en .env et remplir. Ne jamais publier le .env.

# Version de l'image : latest, ou une version précise (2.0.0) pour figer.
IMAGE_TAG=latest

# Comptes : nom=empreinte, séparés par « ; ».
# Empreinte : docker run --rm -it ghcr.io/actarus314/lego python -m app.motdepasse
UTILISATEURS=

# Comptes qui ne voient pas les produits marqués « Acheté » (la surprise), séparés par des virgules.
ACHATS_MASQUES_POUR=

# Adresse et port d'écoute sur l'hôte. 127.0.0.1 : accès local seulement ;
# l'adresse de l'hôte sur le réseau local si un reverse proxy est sur une autre machine.
ADRESSE_ECOUTE=127.0.0.1
PORT_HOTE=8080

# Dossier de l'hôte pour la sélection et les relevés.
DOSSIER_DONNEES=./donnees

# Synchronisation automatique des boutiques, en heures (0 : seulement à la demande).
RELEVE_HEURES=24

# Sources lues, séparées par des virgules (vide : celles marquées actives dans data/sources.json).
# Identifiants : kbs, bausteinreich, mouldkingcorp, bricksvalue (LEGO officiel ; désactivée par défaut :
# ses conditions d'utilisation interdisent la collecte automatisée sans son accord écrit).
SOURCES=

# Alertes sur la sélection (baisse de prix, rupture, retour en vente, retrait annoncé, moins cher ailleurs),
# vérifiées chaque heure, un message par compte. Comptes séparés par « ; », canaux par « , ».
# Exemple : ALERTES=julie=signal:group.abc;romain=signal:group.abc,courriel:romain@exemple.fr
ALERTES=
# Adresse publique du service, pour le lien dans les messages (facultatif).
ADRESSE_PUBLIQUE=

# Serveur d'envoi des courriels. SMTP_SECURITE : starttls (port 587), ssl (port 465) ou aucune.
SMTP_HOTE=
SMTP_PORT=587
SMTP_SECURITE=starttls
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=

# Signal (facultatif) : canal « signal:group.… » (groupe) ou « signal:+336… » dans ALERTES. Démarre le
# conteneur signal-cli-rest-api du compose (COMPOSE_PROFILES=signal), relié une fois au compte (voir README).
# COMPOSE_PROFILES=signal
SIGNAL_URL=http://signal:8080
SIGNAL_NUMERO=
SIGNAL_IMAGE_TAG=0.101
# Dossier de l'hôte pour les clés de l'appareil Signal, appartenant à l'utilisateur 1000.
DOSSIER_SIGNAL=./signal
# Port de l'API Signal sur l'hôte (127.0.0.1 seulement), pour la liaison.
PORT_SIGNAL=8081

# 1 uniquement si l'accès est déjà protégé en amont (reverse proxy avec authentification).
AUTH_DESACTIVEE=0

TZ=Europe/Paris
JOURNAL=INFO
